# XGW: Xray-core. Имя своё, чтобы не конфликтовать с xray.service официального
# установщика. Конфиг пишет XGW; перечитывать его Xray не умеет — только перезапуск.
[Unit]
Description=XGW: Xray-core
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target xgw-net.service
Wants=xgw-net.service
ConditionPathExists=/etc/xgw/xray/config.json

[Service]
User=xray
Group=xray
# CAP_NET_ADMIN — метка на сокетах (sockopt.mark), приём TPROXY и подключение к
# TUN-интерфейсу (его заранее создаёт XGW, см. capture.method = "tun").
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStartPre=/opt/xgw/xray/xray run -test -c /etc/xgw/xray/config.json
ExecStart=/opt/xgw/xray/xray run -c /etc/xgw/xray/config.json
# Xray новее 26.3.27 при остановке выключает интерфейс TUN, и ядро удаляет маршруты через
# него. После каждого запуска XGW возвращает их сразу: «+» — от root, «-» — сбой этой
# команды Xray не останавливает (маршрут вернёт демон на ближайшем шаге).
ExecStartPost=-+/usr/local/bin/xgw net tun
Restart=always
RestartSec=3
LimitNOFILE=1048576
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Остальное ядру не нужно вовсе (аудит, F-11). Проверено под systemd с TUN, TPROXY, меткой на
# сокетах и всеми протоколами sing-box — поведение то же, что без этих строк: параметры и
# модули ядра, его журнал, часы, cgroup, свои пространства имён, realtime, setuid-файлы;
# сокеты — только IP, netlink и UNIX. /dev не скрыт: Xray открывает /dev/net/tun.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
