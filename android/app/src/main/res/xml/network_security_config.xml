<?xml version="1.0" encoding="utf-8"?>
<!-- Только HTTPS и только системные сертификаты: шлюз отвечает через Funnel с сертификатом
     Let's Encrypt на имя <шлюз>.<tailnet>.ts.net. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
