# XGW: sing-box — второе ядро (hysteria2, TUIC, AnyTLS, WireGuard и обход блокировок). Xray
# остаётся точкой входа всего трафика и ведёт к sing-box через его локальные входы на 127.0.0.1.
# Конфиг пишет XGW; служба запускается, только когда он есть (серверов для sing-box нет — её нет).
# Обычный процесс для первого запуска и boot. Рабочий состав меняется отдельным поколением;
# ExecCondition не позволяет запустить дубликат при перезапуске демона во время drain.
[Unit]
Description=XGW: sing-box
Documentation=https://github.com/SagerNet/sing-box
After=network.target nss-lookup.target xgw-net.service
Wants=xgw-net.service
ConditionPathExists=/etc/xgw/sing-box/config.json

[Service]
User=xgw-singbox
Group=xgw-singbox
# Обход перехвата — по UID в nftables. Мосты и API слушают только высокие порты.
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=true
ExecCondition=/usr/local/bin/xgw singbox legacy-ready
ExecStartPre=/opt/xgw/sing-box/sing-box check -c /etc/xgw/sing-box/config.json
ExecStart=/opt/xgw/sing-box/sing-box --disable-color run -c /etc/xgw/sing-box/config.json
ExecReload=/opt/xgw/sing-box/sing-box check -c /etc/xgw/sing-box/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=1048576
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Остальное ядру не нужно вовсе (аудит, F-11). Проверено под systemd с TUN, TPROXY, меткой на
# сокетах и всеми протоколами sing-box — поведение то же, что без этих строк: параметры и
# модули ядра, его журнал, часы, свои пространства имён, realtime, setuid-файлы; сокеты —
# только IP, netlink и UNIX. /dev не скрыт: Xray открывает /dev/net/tun. ProtectControlGroups
# нет. /run — только чтение явной строкой: ProtectKernelTunables (как и ProtectProc и
# ProtectControlGroups) вместе с ProtectSystem=strict открывает его на запись — и в systemd 255
# (Ubuntu 24.04), и в 259 (ASSUMPTIONS п. 252, 253).
ReadOnlyPaths=/run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
