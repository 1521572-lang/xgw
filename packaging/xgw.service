# XGW: демон — подписки, применение через API, watchdog, сканы, уведомления.
[Unit]
Description=XGW: демон (подписки, watchdog, замена серверов)
Documentation=https://github.com/1521572-lang/xgw
After=network.target xgw-net.service xgw-xray.service xgw-singbox.service
Wants=xgw-net.service xgw-xray.service xgw-singbox.service
ConditionPathExists=/etc/xgw/config.toml

[Service]
ExecStart=/usr/local/bin/xgw run
Restart=always
RestartSec=5
# Остановка прерывает текущий шаг демона, но уже начатое применение конфига доводится до
# конца. Установка ждёт перезапуска дольше (install.DAEMON_STOP_WAIT).
TimeoutStopSec=90
RuntimeDirectory=xgw
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
# /etc/xgw — в том числе dnsmasq.conf: панель переписывает его, когда устройство уходит
# мимо VPN (служба DHCP xgw-dhcp читает только его).
ReadWritePaths=/etc/xgw /var/lib/xgw /run/xgw
PrivateTmp=true
NoNewPrivileges=true
# CAP_NET_ADMIN — nft, ip rule, sysctl сети и метка SO_MARK на прямых запросах;
# CAP_SETUID и CAP_SETGID — runuser для уведомления на рабочий стол пользователя;
# CAP_NET_RAW — запись трафика устройства из панели (сокет AF_PACKET, watch/record.py).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SETUID CAP_SETGID
# Остальное демону не нужно (третий аудит 0.2.0, ASSUMPTIONS п. 252): модули и журнал ядра,
# часы, имя машины, свои пространства имён, realtime, setuid-файлы; домашние каталоги и
# /run/user — только чтение (уведомление идёт через сокет /run/user/<uid>/bus, подключаться к
# нему можно и так); сокеты — IP, netlink, UNIX и AF_PACKET (запись трафика). Параметры ядра
# (/proc/sys) открыты: демон ставит форвардинг, rp_filter и BBR; /dev — тоже: TUN.
# ProtectControlGroups нет: в systemd 259 вместе с ProtectSystem=strict он открывает /run на
# запись.
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET

[Install]
WantedBy=multi-user.target
