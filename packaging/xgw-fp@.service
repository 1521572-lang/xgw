# XGW: бесплатный сервер OpenVPN — одно поколение (docs/FREEPOOL-PLAN.md, веха М2а). Запускает и
# останавливает только демон XGW; задание — /run/xgw/fp/<поколение>/manifest.json. Включать службу
# не нужно.
[Unit]
Description=XGW: бесплатный сервер OpenVPN %i (изолированное пространство имён)
Documentation=https://github.com/1521572-lang/xgw
After=network.target xgw-net.service
ConditionPathExists=/run/xgw/fp/%i/manifest.json

[Service]
Type=simple
ExecStart=/usr/local/bin/xgw pool agent %i
# Своё пространство имён сети: в нём только lo, veth передаёт демон (agent.py). Свой /tmp:
# конфиги работников этого поколения другим поколениям не видны.
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
# /run — только чтение явно: с ProtectKernelTunables systemd 259 открывает его на запись.
ReadOnlyPaths=/run
ReadWritePaths=/run/xgw/fp/%i
ProtectHome=yes
UMask=0077
NoNewPrivileges=yes
# CAP_NET_ADMIN — охрана nftables, TUN, адреса и маршруты своего пространства имён;
# CAP_SETUID и CAP_SETGID — работники OpenVPN и SOCKS от своих пользователей (у них
# возможностей нет); CAP_CHOWN — их файлы (root:<группа работника>, 0640); CAP_KILL — их
# остановка (у работников другой uid, а KillMode=mixed шлёт SIGTERM только агенту).
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
MemoryMax=384M
TasksMax=64
Restart=no
TimeoutStopSec=15
# SIGTERM — только агенту: он сам останавливает работников и убирает маршрут; оставшихся
# после его выхода systemd добивает.
KillMode=mixed
