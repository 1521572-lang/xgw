# XGW: правила перехвата — таблицы nftables и маршрутизация по меткам.
# Загружаются раньше сетевых интерфейсов: пока сеть поднимается, мимо VPN ничего
# не уходит. Остановка службы правил не снимает — для этого есть `xgw disable`
# (перехват) и `xgw net down` (все правила XGW).
[Unit]
Description=XGW: правила перехвата (nftables, ip rule)
Documentation=https://github.com/1521572-lang/xgw
DefaultDependencies=no
# nftables.service начинает свой конфиг с flush ruleset — наши правила после него.
After=local-fs.target systemd-sysctl.service nftables.service
Before=network-pre.target shutdown.target
Wants=network-pre.target
Conflicts=shutdown.target
ConditionPathExists=/etc/xgw/config.toml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/xgw net up
ExecReload=/usr/local/bin/xgw net up
RuntimeDirectory=xgw
RuntimeDirectoryPreserve=yes
TimeoutStartSec=60
# Защита службы: писать она может только своё состояние (capture.json) и блокировку;
# /proc/sys/net (форвардинг, BBR) остаётся доступен — ProtectKernelTunables не включён.
# CAP_NET_ADMIN — nft, ip rule, ip route, TUN и sysctl сети; CAP_NET_RAW — запас для
# iproute2 и nft, которым он бывает нужен на сырых сокетах netlink.
ProtectSystem=strict
ReadWritePaths=/var/lib/xgw /run/xgw
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
# Остальное — то, что службе не нужно вовсе: модули, журнал ядра, часы, свои пространства
# имён, realtime, setuid-файлы и системные вызовы вне @system-service. ProtectControlGroups
# нет. /run — только чтение явной строкой (свой каталог из RuntimeDirectory остаётся
# доступным): ProtectProc вместе с ProtectSystem=strict открывает его на запись — и в systemd
# 255 (Ubuntu 24.04), и в 259 (ASSUMPTIONS п. 252, 253).
ReadOnlyPaths=/run
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Сокеты: netlink (nft, ip), UNIX и IP. /dev/net/tun (capture.method = "tun") открыт:
# PrivateDevices не включён.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=sysinit.target
