      },
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "auto"
      }
    ],
    "balancers": [
      {
        "tag": "auto",
        "selector": [
          "proxy-"
        ],
        "strategy": {
          "type": "leastPing"
        },
        "fallbackTag": "proxy-nl-1243"
      }
    ]
  },
  "burstObservatory": {
    "subjectSelector": [
      "proxy-"
    ],
    "pingConfig": {
      "destination": "https://speed.cloudflare.com/__down?bytes=65536",
      "connectivity": "",
      "interval": "30s",
      "sampling": 2,
      "timeout": "8s",
      "httpMethod": "GET"
    }
