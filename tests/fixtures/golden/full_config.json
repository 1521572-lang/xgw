          "probe-nl-1243"
        ],
        "outboundTag": "proxy-nl-1243"
      },
      {
        "type": "field",
        "inboundTag": [
          "probe-de-1f80"
        ],
        "outboundTag": "proxy-de-1f80"
      },
      {
        "type": "field",
        "inboundTag": [
          "probe-fr-a55d"
        ],
        "outboundTag": "spare-fr-a55d"
      },
      {
        "type": "field",
        "inboundTag": [
          "probe-nl-d8a7"
        ],
        "outboundTag": "spare-nl-d8a7"
      },
