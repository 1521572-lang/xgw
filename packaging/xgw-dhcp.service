# XGW: DHCP в сети LAN — свой экземпляр dnsmasq со своим конфигом.
# Не штатная служба dnsmasq.service: её каталог /etc/dnsmasq.d делят все пакеты, и
# чужая строка там (bind-interfaces из пакета ubuntu-fan, который ставится вместе с
# Docker) не давала dnsmasq запуститься вовсе. Здесь читается только /etc/xgw/dnsmasq.conf;
# программа — из пакета dnsmasq-base (он же нужен NetworkManager), DNS в ней выключен.
[Unit]
Description=XGW: DHCP в сети LAN (dnsmasq)
Documentation=https://github.com/1521572-lang/xgw
After=network.target xgw-net.service
ConditionPathExists=/etc/xgw/dnsmasq.conf

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/xgw/dnsmasq.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
RuntimeDirectory=xgw-dhcp
# Защита службы: dnsmasq пишет только аренды (/var/lib/xgw/dhcp.leases) и pid-файл в
# своём каталоге в /run. Права: сокеты DHCP (NET_BIND_SERVICE, NET_RAW, NET_ADMIN) и
# переход на пользователя dnsmasq (SETUID, SETGID, CHOWN — файл аренд и pid-файл); KILL —
# ExecReload: kill от root процессу другого пользователя (dnsmasq уже не root).
ProtectSystem=strict
ReadWritePaths=/var/lib/xgw
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
# Остальное — то, что службе не нужно вовсе: модули, журнал ядра, часы, cgroup, свои
# пространства имён, realtime, setuid-файлы и системные вызовы вне @system-service.
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
PrivateDevices=yes
MemoryDenyWriteExecute=yes
# Сокеты: DHCP — IP и сырой AF_PACKET, netlink — адреса интерфейсов, UNIX — журнал.
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET

[Install]
WantedBy=multi-user.target
